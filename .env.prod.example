# Copy to .env at the repo root and fill in real values before deploying.
# `docker compose -f docker-compose.prod.yml` reads this file both for
# variable substitution (${POSTGRES_*}) and as the api container's env.

# Postgres credentials — pick a strong password, not "momentum".
POSTGRES_DB=momentum
POSTGRES_USER=momentum
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# DATABASE_URL is derived automatically from the POSTGRES_* values above
# in docker-compose.prod.yml — no need to set it here.

SESSION_DAYS=7
# Must be false in production: with DEMO_MODE=true, withdrawal OTP codes
# are shown directly in the UI instead of only being "sent" to the user.
DEMO_MODE=false
# Refreshes wallet prices/24h change from CoinGecko in the background.
# Set to false if this VPS has no outbound internet access.
PRICE_REFRESH_ENABLED=true
PRICE_REFRESH_INTERVAL_SECONDS=60
SUPPORT_EMAIL=support@yourdomain.example
SUPPORT_TELEGRAM=@your_support_handle

# Origin the browser will actually use. With no domain yet, use
# https://<vps-ip> (see deploy/README.md for the self-signed TLS setup
# nginx needs — the session cookie requires HTTPS to work at all).
FRONTEND_ORIGIN=https://your-vps-ip-or-domain
